# Application
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://publicador:publicador@localhost:5432/publicador?schema=public
BUSINESS_ID=blondor
BUSINESS_TIMEZONE=America/Santiago
BUSINESS_CURRENCY=CLP

# Meta Ads
# Use a Graph API version supported by the application configured in Meta Developers.
META_API_VERSION=v20.0
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
# Numeric ID only. Do not include the act_ prefix.
META_AD_ACCOUNT_ID=
META_AD_ACCOUNT_TIMEZONE=Pacific/Easter
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
# E.164 digits only, used to build the click-to-WhatsApp destination URL.
META_WHATSAPP_NUMBER=
# Optional comma-separated trusted origins. Defaults to ASSET_PUBLIC_BASE_URL's origin.
META_IMAGE_ALLOWED_ORIGINS=
# Optional. Not required while commercial conversions come from EasyAppointments.
META_PIXEL_ID=

# Google Drive
# Root folder id. The backend expects two children: `imagenes` and `videos`.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Absolute path to a Google service account JSON key with drive.readonly scope.
GOOGLE_APPLICATION_CREDENTIALS=
# Inline JSON alternative for CI. Do not combine with GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_SERVICE_ACCOUNT_JSON=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=

# Generated asset storage
# Supported target for the MVP: local. Use s3 when public image URLs are required.
ASSET_STORAGE_PROVIDER=local
ASSET_LOCAL_DIRECTORY=.data/assets
ASSET_PUBLIC_BASE_URL=http://localhost:3001/assets
# Public origin used to build the URL of locally converted HEIC -> JPG assets served by the API.
PUBLICADOR_PUBLIC_BASE_URL=http://localhost:3001
# Directory where converted HEIC -> JPG files are persisted for re-use across runs.
PUBLICADOR_MEDIA_DIR=.data/media-assets
# Override the heif-convert binary if it lives outside PATH.
PUBLICADOR_HEIF_CONVERT_BIN=heif-convert
# JPEG quality passed to heif-convert.
PUBLICADOR_HEIF_JPEG_QUALITY=90
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# EasyAppointments
EASYAPPOINTMENTS_BASE_URL=https://agenda.blondor.cl
EASYAPPOINTMENTS_USERNAME=
EASYAPPOINTMENTS_PASSWORD=
EASYAPPOINTMENTS_PROVIDER_ID=6
EASYAPPOINTMENTS_SYNC_CRON=0 */15 * * * *

# Synchronization
SYNC_LOOKBACK_HOURS=72

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
