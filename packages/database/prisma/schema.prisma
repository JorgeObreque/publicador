generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    String?
  socialLinks Json     @default("{}")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services             Service[]
  campaigns            Campaign[]
  creatives            Creative[]
  campaignCreatives    CampaignCreative[]
  mediaAssets          MediaAsset[]
  metaAdAccounts       MetaAdAccount[]
  metaEntityMappings   MetaEntityMapping[]
  adMetrics            AdMetricDaily[]
  trackingEvents       TrackingEvent[]
  conversions          Conversion[]
  experiments          Experiment[]
  insights             Insight[]
  recommendations      OptimizationRecommendation[]
  decisionLog          DecisionLogEntry[]
  externalAppointments ExternalAppointment[]
  serviceMappings      EasyAppointmentsServiceMap[]
  remoteCampaigns      MetaRemoteCampaign[]
  remoteMetrics        MetaRemoteMetricDaily[]
  profile              BusinessProfile?
  campaignBriefs       CampaignBrief[]
  commercialDiagnoses  CommercialDiagnosis[]

  @@index([name])
}

model BusinessProfile {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  addressLine    String?
  neighborhood   String?
  regionCutCode  String?
  communeCutCode String?
  countryCode    String?
  phone          String?
  whatsappNumber String?
  publicEmail    String?
  googleMapsUrl  String?

  brandVoiceKeywords      String[]
  wordsToAvoid            String[]
  preferredEmojiSemantics String[]

  primaryCustomerProfile String?
  commonObjections       String[]
  qualifyingQuestions    String[]

  weeklyServiceCapacity  Int?
  monthlyRevenueTarget   Decimal? @db.Decimal(12, 2)
  monthlyAcquisitionGoal Int?
  costPerAcquisitionCap  Decimal? @db.Decimal(12, 2)

  tagline         String?
  differentiators String[]

  nearbyCommunesCutCodes String[] @default([])

  profileCompletedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([businessId])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("CLP")
  duration    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business             Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns            Campaign[]
  conversions          Conversion[]
  externalAppointments ExternalAppointment[]
  externalServiceMaps  EasyAppointmentsServiceMap[]
  campaignBriefs       CampaignBrief[]
  commercialDiagnoses  CommercialDiagnosis[]

  @@unique([businessId, name])
  @@index([businessId])
}

model MediaAsset {
  id                String           @id @default(cuid())
  businessId        String
  source            MediaAssetSource
  kind              MediaAssetKind
  externalFileId    String
  externalFolderId  String?
  externalFolderKey String?
  externalLink      String?
  name              String
  mimeType          String
  sizeBytes         Int
  checksum          String?
  width             Int?
  height            Int?
  durationSeconds   Int?
  status            MediaAssetStatus @default(READY)
  archivedAt        DateTime?
  lastSyncedAt      DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creatives Creative[]

  @@unique([businessId, source, externalFileId])
  @@index([businessId])
  @@index([businessId, kind])
  @@index([businessId, status])
}

enum MediaAssetSource {
  GOOGLE_DRIVE
  URL
}

enum MediaAssetKind {
  IMAGE
  VIDEO
}

enum MediaAssetStatus {
  READY
  MISSING
  ARCHIVED
}

model Campaign {
  id                     String            @id @default(cuid())
  businessId             String
  serviceId              String?
  name                   String
  objective              String
  status                 CampaignStatus    @default(DRAFT)
  pausedAt               DateTime?
  startDate              DateTime?
  endDate                DateTime?
  dailyBudget            Decimal?          @db.Decimal(12, 2)
  lifetimeBudget         Decimal?          @db.Decimal(12, 2)
  metaCampaignId         String?
  metaAdSetId            String?
  metaPublishFingerprint String?
  metaPublishStatus      MetaPublishStatus @default(DRAFT)
  metaPublishAttemptId   String?
  metaPublishError       String?
  metaPublishStartedAt   DateTime?
  metaPublishedAt        DateTime?
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service            Service?            @relation(fields: [serviceId], references: [id])
  campaignBriefId    String?
  campaignBrief      CampaignBrief?      @relation(fields: [campaignBriefId], references: [id], onDelete: SetNull)
  campaignCreatives  CampaignCreative[]
  metaEntityMappings MetaEntityMapping[]
  metrics            AdMetricDaily[]
  conversions        Conversion[]
  experiments        Experiment[]

  @@unique([businessId, metaCampaignId])
  @@unique([businessId, metaAdSetId])
  @@index([businessId])
  @@index([businessId, status])
  @@index([serviceId])
  @@index([campaignBriefId])
}

enum MetaPublishStatus {
  DRAFT
  PUBLISHING
  PAUSED
  FAILED
}

enum CampaignStatus {
  DRAFT
  PAUSED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CampaignBriefStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model CampaignBrief {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  title  String
  status CampaignBriefStatus @default(DRAFT)

  businessObjective String
  offer             String
  primaryKpi        String

  idealCustomerProfile String?
  qualifyingQuestions  String[]

  monthlyAcquisitionGoal Int?
  costPerAcquisitionCap  Decimal? @db.Decimal(12, 2)
  lifetimeBudgetCap      Decimal? @db.Decimal(12, 2)
  dailyBudgetCap         Decimal? @db.Decimal(12, 2)
  plannedDurationDays    Int?

  constraints String[]

  stopIf  String?
  scaleIf String?

  approvedAt DateTime?
  approvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
  diagnosis CommercialDiagnosis?

  @@index([businessId])
  @@index([businessId, status])
}

model CommercialDiagnosis {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status CommercialDiagnosisStatus @default(IN_PROGRESS)

  currentSituation String

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Análisis IA (nullable mientras IN_PROGRESS)
  situation            String?
  opportunity          String?
  primaryGoal          String?
  primaryConversion    String?
  recommendedTitle     String?
  recommendedWeeklyAdd Int?
  availableCapacity    Int?

  // Estrategia auto-precios (nullable hasta READY/ACCEPTED)
  businessObjective        String?
  offer                    String?
  primaryKpi               String?
  idealCustomerProfile     String?
  qualifyingQuestions      String[]
  constraints              String[]
  stopIf                   String?
  scaleIf                  String?
  initialDailyBudgetCLP    Decimal? @db.Decimal(12, 2)
  initialLifetimeBudgetCLP Decimal? @db.Decimal(12, 2)
  initialDurationDays      Int?
  initialCpaTargetCLP      Decimal? @db.Decimal(12, 2)
  initialCpaCapCLP         Decimal? @db.Decimal(12, 2)
  progressionSteps         Int[]

  recommendedStartDate     DateTime?      @db.Date
  recommendedEndDate       DateTime?      @db.Date
  recommendedWeekdays      Int[]          @default([])
  budgetExplanation        String?
  scheduleExplanation      String?
  assumptions              String[]       @default([])
  goalAssessment           Json?

  provenance Json @default("{}")

  campaignBriefId String?        @unique
  campaignBrief   CampaignBrief? @relation(fields: [campaignBriefId], references: [id], onDelete: SetNull)

  answers DiagnosticAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, status])
}

model DiagnosticAnswer {
  id               String              @id @default(cuid())
  diagnosisId      String
  diagnosis        CommercialDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  questionKey      String
  questionText     String
  answerText       String?
  wasClarification Boolean             @default(false)
  askedAt          DateTime            @default(now())
  answeredAt       DateTime?

  @@index([diagnosisId])
}

enum CommercialDiagnosisStatus {
  IN_PROGRESS
  READY
  ACCEPTED
  ARCHIVED
}

enum CommercialDataSource {
  USER_PROFILE
  USER_CURRENT_SITUATION
  AI_INFERENCE
  SYSTEM_CALCULATION
  AI_RECOMMENDATION
  CAMPAIGN_OBSERVED_DATA
}

model Creative {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  format         String
  primaryText    String
  headline       String
  description    String?
  callToAction   String
  imageUrl       String?
  mediaAssetId   String?
  metaCreativeId String?
  isAiGenerated  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mediaAsset         MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  campaignCreatives  CampaignCreative[]
  metaEntityMappings MetaEntityMapping[]
  conversions        Conversion[]
  experimentVariants ExperimentVariant[]

  @@unique([businessId, metaCreativeId])
  @@index([businessId])
  @@index([mediaAssetId])
}

model CampaignCreative {
  id                     String    @id @default(cuid())
  businessId             String
  campaignId             String
  creativeId             String
  attributionCode        String    @unique
  isControl              Boolean   @default(false)
  metaCreativeId         String?
  metaAdId               String?
  metaPublishFingerprint String?
  metaPublishedAt        DateTime?
  createdAt              DateTime  @default(now())

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative           Creative            @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  metrics            AdMetricDaily[]
  conversions        Conversion[]
  experimentVariants ExperimentVariant[]

  @@unique([campaignId, creativeId])
  @@unique([businessId, metaCreativeId])
  @@unique([businessId, metaAdId])
  @@index([businessId])
  @@index([creativeId])
  @@index([businessId, campaignId])
}

model MetaAdAccount {
  id            String   @id @default(cuid())
  businessId    String
  metaAccountId String
  name          String
  currency      String   @default("CLP")
  timezone      String   @default("Pacific/Easter")
  createdAt     DateTime @default(now())

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mappings MetaEntityMapping[]

  @@unique([businessId, metaAccountId])
}

model MetaEntityMapping {
  id          String         @id @default(cuid())
  businessId  String
  adAccountId String?
  entityType  MetaEntityType
  metaId      String
  campaignId  String?
  creativeId  String?
  createdAt   DateTime       @default(now())

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adAccount MetaAdAccount? @relation(fields: [adAccountId], references: [id])
  campaign  Campaign?      @relation(fields: [campaignId], references: [id])
  creative  Creative?      @relation(fields: [creativeId], references: [id])

  @@unique([entityType, metaId])
  @@index([businessId])
  @@index([adAccountId])
  @@index([campaignId])
  @@index([creativeId])
}

enum MetaEntityType {
  CAMPAIGN
  ADSET
  AD
  CREATIVE
}

model AdMetricDaily {
  id                 String   @id @default(cuid())
  businessId         String
  campaignId         String
  campaignCreativeId String?
  date               DateTime @db.Date
  impressions        Int      @default(0)
  reach              Int      @default(0)
  clicks             Int      @default(0)
  spend              Decimal  @default(0) @db.Decimal(12, 2)
  leads              Int      @default(0)
  createdAt          DateTime @default(now())

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignCreative CampaignCreative? @relation(fields: [campaignCreativeId], references: [id], onDelete: SetNull)

  @@unique([campaignId, campaignCreativeId, date])
  @@unique([campaignId, date], map: "uniq_campaign_metric_per_day_no_creative")
  @@index([businessId, date])
  @@index([campaignCreativeId])
}

model TrackingEvent {
  id                    String            @id @default(cuid())
  businessId            String
  eventType             TrackingEventType
  eventId               String
  source                String?
  medium                String?
  campaign              String?
  utmCampaignId         String?
  utmCampaignCreativeId String?
  occurredAt            DateTime          @default(now())
  payload               Json              @default("{}")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, eventType, eventId])
  @@index([businessId, occurredAt])
}

enum TrackingEventType {
  CLICK
  VISIT
  WHATSAPP_OPEN
  FORM_SUBMIT
}

model Conversion {
  id                    String           @id @default(cuid())
  businessId            String
  campaignId            String?
  creativeId            String?
  campaignCreativeId    String?
  serviceId             String?
  attributionCode       String?
  status                ConversionStatus @default(PENDING)
  amount                Decimal?         @db.Decimal(12, 2)
  currency              String           @default("CLP")
  contactRef            String?
  notes                 String?
  externalAppointmentId String?
  occurredAt            DateTime         @default(now())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign            Campaign?            @relation(fields: [campaignId], references: [id])
  creative            Creative?            @relation(fields: [creativeId], references: [id])
  campaignCreative    CampaignCreative?    @relation(fields: [campaignCreativeId], references: [id])
  service             Service?             @relation(fields: [serviceId], references: [id])
  externalAppointment ExternalAppointment? @relation(fields: [externalAppointmentId], references: [id])

  @@unique([businessId, externalAppointmentId])
  @@index([businessId, occurredAt])
  @@index([businessId, status])
  @@index([campaignId])
  @@index([creativeId])
  @@index([campaignCreativeId])
  @@index([serviceId])
}

enum ConversionStatus {
  PENDING
  DEPOSIT_CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

model Experiment {
  id         String           @id @default(cuid())
  businessId String
  campaignId String
  name       String
  hypothesis String
  primaryKpi String
  status     ExperimentStatus @default(RUNNING)
  startedAt  DateTime         @default(now())
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variants ExperimentVariant[]
  insights Insight[]

  @@index([businessId])
  @@index([campaignId])
}

enum ExperimentStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

model ExperimentVariant {
  id                 String   @id @default(cuid())
  experimentId       String
  campaignCreativeId String
  creativeId         String
  isControl          Boolean  @default(false)
  createdAt          DateTime @default(now())

  experiment       Experiment       @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  campaignCreative CampaignCreative @relation(fields: [campaignCreativeId], references: [id])
  creative         Creative         @relation(fields: [creativeId], references: [id])

  @@unique([experimentId, campaignCreativeId])
  @@index([campaignCreativeId])
  @@index([creativeId])
}

model Insight {
  id           String          @id @default(cuid())
  businessId   String
  experimentId String?
  category     String
  severity     InsightSeverity @default(INFO)
  title        String
  description  String
  evidence     Json            @default("{}")
  createdAt    DateTime        @default(now())

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  experiment Experiment? @relation(fields: [experimentId], references: [id])

  @@index([businessId, createdAt])
  @@index([experimentId])
}

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
}

model OptimizationRecommendation {
  id            String               @id @default(cuid())
  businessId    String
  category      String
  title         String
  rationale     String
  impact        String
  status        RecommendationStatus @default(PENDING)
  decisionLogId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  decisionLog DecisionLogEntry? @relation(fields: [decisionLogId], references: [id])

  @@index([businessId, status])
  @@index([decisionLogId])
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  APPLIED
}

model DecisionLogEntry {
  id             String    @id @default(cuid())
  businessId     String
  title          String
  rationale      String
  expectedImpact String?
  outcome        String?
  decidedAt      DateTime  @default(now())
  evaluatedAt    DateTime?
  createdAt      DateTime  @default(now())

  business        Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recommendations OptimizationRecommendation[]

  @@index([businessId, decidedAt])
}

model ExternalAppointment {
  id                    String            @id @default(cuid())
  businessId            String
  serviceId             String?
  externalAppointmentId BigInt
  externalCustomerId    BigInt?
  providerId            Int?
  scheduledStart        DateTime
  scheduledEnd          DateTime
  appointmentStatus     String
  notesRaw              String?
  attributionCode       String?
  campaignId            String?
  creativeId            String?
  campaignCreativeId    String?
  depositConfirmed      Boolean           @default(false)
  depositAmount         Decimal?          @db.Decimal(12, 2)
  depositCurrency       String?
  outcome               ConversionStatus?
  finalRevenue          Decimal?          @db.Decimal(12, 2)
  finalRevenueCurrency  String?
  rawPayload            Json              @default("{}")
  syncedAt              DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service    Service?     @relation(fields: [serviceId], references: [id])
  conversion Conversion[]

  @@unique([businessId, externalAppointmentId])
  @@index([businessId, scheduledStart])
  @@index([attributionCode])
  @@index([serviceId])
}

model MetaRemoteMetricDaily {
  id             String   @id @default(cuid())
  businessId     String
  metaCampaignId String
  metaAdSetId    String?
  metaAdId       String?
  adSetName      String?
  adName         String?
  date           DateTime
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  spend          Decimal  @default(0) @db.Decimal(12, 2)
  leads          Int      @default(0)
  fetchedAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metaCampaignId, metaAdId, date])
  @@index([businessId])
  @@index([businessId, metaCampaignId])
  @@index([businessId, date])
  @@index([businessId, metaCampaignId, metaAdSetId])
}

model MetaRemoteCampaign {
  id              String    @id @default(cuid())
  businessId      String
  metaCampaignId  String
  name            String
  status          String
  effectiveStatus String?
  objective       String?
  dailyBudget     String?
  lifetimeBudget  String?
  startTime       DateTime?
  stopTime        DateTime?
  fetchedAt       DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metaCampaignId])
  @@index([businessId])
  @@index([businessId, status])
}

model EasyAppointmentsServiceMap {
  id                String   @id @default(cuid())
  businessId        String
  externalServiceId Int
  serviceId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])

  @@unique([businessId, externalServiceId])
  @@index([serviceId])
}
